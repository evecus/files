{
  "dns": {
    "servers": [
      {"tag": "ali-dns", "type": "https", "server": "223.5.5.5"},
      {"tag": "geogle-dns", "type": "https", "server": "8.8.8.8", "detour": "默认代理"}
    ],
    "rules": [
      {"clash_mode": "direct", "server": "ali-dns"},
      {"clash_mode": "global", "server": "fakeip"},
      {"query_type": "HTTPS", "action": "reject"},
      {"rule_set": ["meproxy", "foreign_domain"], "server": "geogle-dns"},
      {"rule_set": ["medirect", "geosite-cn"], "server": "ali-dns"}
    ],
    "final": "geogle-dns",
    "strategy": "prefer_ipv4",
    "independent_cache": true,
    "reverse_mapping": true
  },
  "route": {
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns"
        ]
      },
      {
        "inbound": "dns-in",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "直连"
      },
      {
        "clash_mode": "direct",
        "outbound": "直连"
      },
      {
        "clash_mode": "global",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "medirect",
        "outbound": "直连"
      },
      {
        "rule_set": "meproxy",
        "outbound": "默认代理"
      },
      {
        "rule_set": "ads",
        "outbound": "拦截"
      },
      {
        "rule_set": "foreign_domain",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "直连"
      },
      {
        "rule_set": "foreign_ip",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "直连"
      }
    ],
    "rule_set": [
      {
        "tag": "medirect",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@main/sing-box/direct.srs",
        "download_detour": "直连"
      },
      {
        "tag": "meproxy",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@main/sing-box/proxy.srs",
        "download_detour": "直连"
      },
      {
        "tag": "foreign_domain",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@main/sing-box/foreign_domain-lite.srs",
        "download_detour": "直连"
      },
      {
        "tag": "foreign_ip",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@main/sing-box/foreign_ip4.srs",
        "download_detour": "直连"
      },
      {
        "tag": "ads",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@main/sing-box/ads_domain-lite.srs",
        "download_detour": "直连"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@main/sing-box/cn_ip-lite.srs",
        "download_detour": "直连"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@main/sing-box/cn_domain-lite.srs",
        "download_detour": "直连"
      }
    ],
    "final": "漏网之鱼",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "geogle-dns"
    }
  },
  "inbounds": [
    {
      "tag": "dns-in",
      "type": "direct",
      "listen": "::",
      "listen_port": 1153
    },
    {
      "tag": "redirect-in",
      "type": "redirect",
      "listen": "::",
      "listen_port": 7896
    },
    {
      "tag": "tproxy-in",
      "type": "tproxy",
      "listen": "::",
      "listen_port": 7899
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/momo/run/cache.db",
      "store_fakeip": false
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "/etc/momo/run/ui",
      "external_ui_download_url": "https://fastly.jsdelivr.net/gh/evecus/rules_set@ui/zashboard-gh-pages.zip",
      "external_ui_download_detour": "直连",
      "secret": "1234",
      "default_mode": "rule"
    }
  },
  "outbounds": [
    {
      "tag": "默认代理",
      "type": "selector",
      "outbounds": []
    },
    {
      "tag": "漏网之鱼",
      "type": "selector",
      "outbounds": [
        "直连",
        "默认代理"
      ]
    },
    {
      "tag": "直连",
      "type": "direct"
    },
    {
      "tag": "拦截",
      "type": "block"
    }
  ],
  "log": {
    "disabled": true
  }
}
